# Copy this file to .env and fill in what you need.
# NEVER commit the real .env file - it is gitignored for a reason.

# ---------------------------------------------------------------------------
# Places provider
# ---------------------------------------------------------------------------

# "google" (default) or "openstreetmap".
#
# google         - ratings, price levels, better coverage. Needs a billing
#                  account. Free at normal volume: 5,000 Nearby Search calls
#                  per month, and one user search costs exactly one call.
# openstreetmap  - no key, no billing, no account. No ratings or prices.
#                  Always available as a fallback if a key is revoked.
#
# If "google" is set but no key is found, the app falls back to
# OpenStreetMap automatically rather than failing every search.
PLACES_PROVIDER=google

# Google Cloud API key. Enable "Places API (New)" for restaurant search and
# "Geocoding API" for the typo-tolerant location fallback (e.g. resolving a
# misspelled "San Fransisco CA"). Restrict the key to just those two APIs and
# set a daily quota cap (~100/day) in Google Cloud Console so overage is
# impossible rather than merely unlikely.
#
# IMPORTANT: this must be a single line, no quotes, no spaces around the "=".
GOOGLE_MAPS_API_KEY=your_key_here

# Request Google's enterprise dietary fields (servesVegetarianFood).
# This drops the free allowance from 5,000 calls/month to 1,000, and the
# cuisine priors already cover most of the same ground. Leave it false.
INCLUDE_DIETARY_FLAGS=false

# ---------------------------------------------------------------------------
# OpenStreetMap (only used when PLACES_PROVIDER=openstreetmap)
# ---------------------------------------------------------------------------

# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_MIRRORS=https://overpass.kumi.systems/api/interpreter

# Sent to Overpass and Nominatim, which require an identifying User-Agent.
# USER_AGENT=Chompers/1.0 (group restaurant matcher)

# Restrict typed-location geocoding to these ISO country codes (comma-
# separated). Defaults to "us" so "San Francisco, CA" resolves to California
# and never a same-named town abroad. Leave blank to allow any country.
# GEOCODE_COUNTRY_CODES=us

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Comma-separated list of origins allowed to call this backend.
# ALLOWED_ORIGINS=http://localhost:5173

# Max requests allowed per IP per minute.
# RATE_LIMIT_PER_MINUTE=30

# Number of trusted reverse proxies in front of this backend.
# Leave at 0 for direct/local runs: X-Forwarded-For is then ignored so it
# cannot be spoofed to dodge the rate limit. Set it to the exact hop count
# ONLY when deployed behind proxies you control (e.g. 1 for a single nginx),
# so the real client IP is read from the trusted end of the chain.
# TRUSTED_PROXY_COUNT=0

# How long a search response stays cached. Restaurant data changes on a
# scale of days, so a long TTL saves a lot of slow refetching.
# CACHE_TTL_SECONDS=86400

# Where cached responses are stored between runs.
# CACHE_DIR=.cache/places
