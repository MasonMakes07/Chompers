# Copy this file to backend/.env and fill in your real key.
# NEVER commit the real .env file.

# Google Cloud API key with "Places API (New)" and "Geocoding API" enabled.
# Restrict the key to those two APIs and set a daily quota cap (~100/day)
# in Google Cloud Console so overage is impossible.
GOOGLE_MAPS_API_KEY=your_key_here

# Comma-separated list of origins allowed to call this backend.
ALLOWED_ORIGINS=http://localhost:5173

# Max searches allowed per IP per minute.
RATE_LIMIT_PER_MINUTE=10

# Seconds to cache a Places response for a given rounded location.
CACHE_TTL_SECONDS=900
