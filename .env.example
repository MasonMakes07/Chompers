# Copy this file to .env if you want to override any default.
# Chompers runs on OpenStreetMap, so NO API KEY IS REQUIRED - the app works
# out of the box with none of these set.

# Overpass mirror to query. The default is fine; switch to a mirror only if
# the main instance is slow or rate limiting you.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Alternative mirror:
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# Sent to Overpass and Nominatim, which require an identifying User-Agent.
# Add contact info here if you ever deploy this publicly - it is their policy.
# USER_AGENT=Chompers/1.0 (group restaurant matcher)

# Comma-separated list of origins allowed to call this backend.
# ALLOWED_ORIGINS=http://localhost:5173

# Max searches allowed per IP per minute.
# RATE_LIMIT_PER_MINUTE=10

# Seconds to cache a search response for a given rounded location.
# CACHE_TTL_SECONDS=900
